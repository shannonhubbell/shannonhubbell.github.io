---
import MainMenu from "../components/MainMenu.astro";
---

<header>
    <div class="inner">
        <h1><a href="/">Shannon Ellery Hubbell</a></h1>
        <h2>Writer. Coder. Dinosaur&nbsp;aficionado.</h2>
        <MainMenu />
    </div>
    <a class="mug align-right" href="/"
        ><img
            src="/img/headshot.webp"
            alt="Headshot of Shannon"
            width="150"
            height="150"
        />
    </a>
</header>

<style>
    header {
        width: 800px;
        max-width: calc(100% - 2em);
        margin: 0 auto;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
    }

    h1 {
        font-size: 2.5rem;
        margin: 0;
        text-wrap: pretty;
        a {
            color: var(--color-highlight);
            text-decoration: none;
        }
    }

    h2 {
        color: #444;
        margin: 0;
        padding: 0.4rem 0 0 0;
    }
    div.inner {
        vertical-align: middle;
        justify-content: center;
        width: calc(100% - 200px);
        text-align: right;
    }
    a.mug {
        border-radius: 50% 0 50% 0;
        aspect-ratio: 1 /1;
        border: 10px solid var(--color-highlight);
        display: inline-block;
        line-height: 0;
        overflow: hidden;
        img {
            filter: grayscale(100);
            transition: all .5s;
            transform: scale(1);
            &:hover {
                filter: grayscale(0);
                transform: scale(1.1);
            }
        }
    }
    @media screen and (width < 600px) {
        header {
            display: block;
        }
        div.inner {
            width: auto;
            text-align:;
        }
        a.mug {
            display: none;
        }
        h1 {
            font-size: 3rem;
        }
    }
</style>
