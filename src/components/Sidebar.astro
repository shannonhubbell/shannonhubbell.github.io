---
import ToonShannon from "../assets/toon-shannon-coding.webp";
import WritingFuryRoad from "../assets/header-citadel.webp";
---
<aside>
    <nav>
        <ul>
            <li><a href="/portfolio" class="portfolio">
                <img src={ToonShannon.src} alt="Cartoon of Shannon with his laptop, having an idea lightbulb over his head">
                <span>Web Development &amp; Video</span></a>
            </li>
            <li>
                <a href="/writing" class="writing">
                    <img src={WritingFuryRoad.src} alt="The Citadel from MAX MAX: FURY ROAD">
                    <span>Writing</span>
                </a></li>
        </ul>
    </nav>
</aside>

<style>
    aside {
        ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        li {
            margin: 2rem 0;
        }
        a {
            display: block;
            background-color: var(--color-highlight);
            background-size: cover;
            text-decoration: none;
            aspect-ratio: 1;
            color: #FFF;
            position: relative;
            overflow: hidden;
            border: 10px solid var(--color-highlight);
            border-radius: 30% 0 30% 0;
            img {
                filter: grayscale() contrast(180%);
                transform: scale(1);
                position: absolute;
                left: 0;
                top: -2.5rem;
                object-fit: cover;
                max-height: 100%;
                transition: all .5s;
                &:hover {
                    transform: scale(1.1);
                    filter: grayscale(0) contrast(180%);
                }
            }
            span {
                background: #000;
                padding: 1rem;
                font-size: 1rem;
                display: block;
                position: absolute;
                bottom: 0;
                width: calc(100% - 2rem);
            }
            &.writing {
                border-radius: 0 30%;
                text-align: right;
            }
        }
    }
</style>
