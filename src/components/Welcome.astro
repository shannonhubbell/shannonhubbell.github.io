---
import astroLogo from '../assets/astro.svg';
import backgroundImage from '../assets/sea-critters.webp';
const backgroundColor = "#000000";
const backgroundURL = `url('${backgroundImage.src}')`; 
---


<div id="container">
	<main>
		<section id="hero">
			
			<h1>
				Shannon Hubbell | Developer, Writer, Dinosaur Fan
			</h1>
			<section id="links">
				<a class="button" href="https://docs.astro.build">Read our docs</a>
				
			</section>
		</section>
	</main>
</div>

{backgroundURL}

<style>
	body {
		background-repeat: no-repeat;
		background-size: cover;
		background-image: url('../assets/sea-critters.webp');
	}
</style>
