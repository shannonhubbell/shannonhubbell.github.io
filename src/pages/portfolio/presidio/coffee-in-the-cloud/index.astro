---
import  PortfolioBar from "../../../../components/PortfolioBar.astro";
---
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Sit back and enjoy a cup of Joe.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://vjs.zencdn.net/7.11.4/video-js.css" rel="stylesheet">
  <script src="https://vjs.zencdn.net/7.11.4/video.min.js"></script><!-- minified jquery lib from cdn -->
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"
    integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@700&family=Montserrat:wght@400;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/portfolio-assets/presidio/coffee-in-the-cloud/css/app.css">
</head>

<body class="temp-landing">
  <PortfolioBar />
  <div class="page-width">
    <header><img src="/portfolio-assets/presidio/coffee-in-the-cloud/images/logos-white-presidio-partner-meraki.svg" alt="Presidio | Cisco| Cisco Meraki"
        class="logos">
      <h1>Sit back and enjoy a cup of Joe.</h1>
      <p>Your monthly content will be available very soon. Look for the QR code in your next box of coffee.</p>
    </header>
    <div class="cup"><img src="images/cup-o-joe.svg" alt="" class="cup" width="728"></div>
  </div>
  <footer id="byline">
    <div class="page-width">
      <div class="created-by">Site created by<br><img src="/portfolio-assets/presidio/coffee-in-the-cloud/images/viewstream-logo.svg" alt="Viewstream"></div>
      <div class="boiler">&copy; 2024 Viewstream, Inc. All rights reserved.<br><a href="https://viewstream.com/privacy"
          target="_blank">Privacy Policy</a> | <a href="https://viewstream.com/terms" target="_blank">Terms of Service &
          Cookie Policy</a></div>
    </div>
  </footer>
  <script is:inline src="/portfolio-assets/presidio/coffee-in-the-cloud/js/main.js"></script>
</body>

</html>